# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Next.js public vars
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Backend
BACKEND_PORT=3001
JWT_SECRET=your-jwt-secret

# Venue catalog pipeline (scripts/venue-pipeline.ts) — all optional
# Google Places API (New): organization name/address/phone/website/hours at a point.
# One request per court group; a single city stays inside the free monthly tier.
GOOGLE_PLACES_API_KEY=
# Claude agent for the `venues agent` step (web search + page reading)
ANTHROPIC_API_KEY=
# Geoapify Places for `ingest:austin` (fills private clubs missing from OSM)
GEOAPIFY_API_KEY=
