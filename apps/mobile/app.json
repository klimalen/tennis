{
  "expo": {
    "name": "GAME.",
    "slug": "tennis",
    "scheme": "tennis",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#2F6667",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F2"
    },
    "ios": {
      "bundleIdentifier": "com.klimalen.tennis",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "GAME. uses the camera when you add a profile photo or a post.",
        "NSPhotoLibraryUsageDescription": "GAME. uses your photos when you add a profile photo or a post.",
        "NSPhotoLibraryAddUsageDescription": "GAME. saves a photo you take for your profile or a post.",
        "NSMicrophoneUsageDescription": "GAME. uses the microphone when you record a video for a post.",
        "NSLocationWhenInUseUsageDescription": "GAME. uses your location to show nearby players, games, and courts.",
        "LSApplicationQueriesSchemes": ["mailto", "tel", "sms", "itms-apps"]
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ]
      }
    },
    "android": {
      "package": "com.klimalen.tennis",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2F6667"
      },
      "permissions": ["CAMERA", "ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "plugins": ["expo-router"],
    "extra": {
      "privacyPolicyUrl": "https://www.game-tennis.space/privacy",
      "termsOfUseUrl": "https://www.game-tennis.space/terms"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
